<mxfile host="app.diagrams.net" version="26.0.0"><diagram name="01 - Logical ERD" id="01_-_Logical_ERD"><mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c1" value="AGENTOS DATABASE — Logical ERD (review draft, not implemented)" style="text;html=1;fontSize=17;fontStyle=1;fontColor=#0F172A;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1540" height="40" as="geometry" /></mxCell><mxCell id="c2" value="Legend — PK primary key · FK foreign key · UQ unique · 1:N one-to-many · N:N via junction table · [CONFIRMED] named in plans/SQL · [CONTRACT] frontend contract only · [UNCONFIRMED] needed but undefined · Persistent Data = solid table nodes · External/Object Storage = dashed boxes · Vector Storage = dashed Vector Store box · Runtime/External Service = dashed Redis/LLM boxes (never tables)" style="rounded=1;html=1;whiteSpace=wrap;fontSize=10;fontColor=#64748B;fillColor=#FFFFFF;strokeColor=#E2E8F0;" vertex="1" parent="1"><mxGeometry x="20" y="52" width="1540" height="28" as="geometry" /></mxCell><mxCell id="c3" value="EXTERNAL — not tables. Dashed boxes at the bottom link to the tables that use them. Binaries → Object Storage · embeddings → Vector Store · queue/cache/pub-sub → Redis · inference → LLM Provider · secrets → Secret Storage (never plaintext columns)." style="rounded=1;html=1;fontSize=11;fontColor=#64748B;fillColor=#F8FAFC;strokeColor=#E2E8F0;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="86" width="1540" height="64" as="geometry" /></mxCell><mxCell id="c4" value="" style="rounded=1;html=1;fillColor=#F8FAFC;strokeColor=#E2E8F0;" vertex="1" parent="1"><mxGeometry x="20" y="176" width="370" height="650" as="geometry" /></mxCell><mxCell id="c5" value="● IDENTITY &amp; WORKSPACE" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#2563EB