OPENAI_API_BASE=https://your-openai-compatible-base-url/v1
OPENAI_MODEL_NAME=gpt-4o-mini
# --- Enterprise platform (scaffold defaults) ---
DATABASE_URL=postgresql+psycopg://rag:changeme@localhost:5432/rag_auto
